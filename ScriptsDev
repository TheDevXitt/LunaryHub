local threatParts = {}
local threatConnections = {}
local noThreatsGuiButton = nil

local function clearAllThreats()
    for key, conn in pairs(threatConnections) do
        if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
    end
    threatConnections = {}

    for key, block in pairs(threatParts) do
        if block and block.Parent then
            block:Destroy()
        end
    end
    threatParts = {}
end

local function attachPlayerBlock(player)
    if player == LocalPlayer or not noThreatsOptionActive or not noThreatsRunning then return end
    
    local function onCharAdded(char)
        if not noThreatsOptionActive or not noThreatsRunning then return end
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not hrp or not noThreatsOptionActive or not noThreatsRunning then return end

        if threatParts[player] and threatParts[player].Parent then
            threatParts[player]:Destroy()
        end

        local block = createInvisibleBlock(hrp, "PlayerShield_" .. player.UserId)
        threatParts[player] = block
    end

    if player.Character then
        task.spawn(onCharAdded, player.Character)
    end
    
    if threatConnections[player] then
        threatConnections[player]:Disconnect()
    end
    threatConnections[player] = player.CharacterAdded:Connect(onCharAdded)
end

local playerAddedConn
local playerRemovingConn

local function createNoThreatsScreenButton()
    if noThreatsGuiButton then return end
    
    noThreatsGuiButton = Instance.new("TextButton")
    noThreatsGuiButton.Name = "NoThreatsScreenBtn"
    noThreatsGuiButton.Size = UDim2.new(0, 140, 0, 38)
    noThreatsGuiButton.Position = UDim2.new(0.5, -70, 0, 15)
    noThreatsGuiButton.BackgroundColor3 = currentThemeColor
    noThreatsGuiButton.Text = "No Threats: OFF"
    noThreatsGuiButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    noThreatsGuiButton.TextSize = 13
    noThreatsGuiButton.Font = Enum.Font.Ubuntu
    noThreatsGuiButton.Draggable = true
    noThreatsGuiButton.Active = true
    noThreatsGuiButton.Parent = ScreenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = noThreatsGuiButton

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = 1.5
    stroke.Parent = noThreatsGuiButton

    noThreatsGuiButton.MouseButton1Click:Connect(function()
        noThreatsRunning = not noThreatsRunning
        if noThreatsRunning then
            noThreatsGuiButton.Text = "No Threats: ON"
            noThreatsGuiButton.BackgroundColor3 = Color3.fromRGB(50, 205, 50)
            
            for _, player in ipairs(Players:GetPlayers()) do
                attachPlayerBlock(player)
            end
            
            playerAddedConn = Players.PlayerAdded:Connect(function(player)
                attachPlayerBlock(player)
            end)
            
            playerRemovingConn = Players.PlayerRemoving:Connect(function(player)
                if threatConnections[player] then
                    threatConnections[player]:Disconnect()
                    threatConnections[player] = nil
                end
                if threatParts[player] then
                    threatParts[player]:Destroy()
                    threatParts[player] = nil
                end
            end)
        else
            noThreatsGuiButton.Text = "No Threats: OFF"
            noThreatsGuiButton.BackgroundColor3 = currentThemeColor
            
            if playerAddedConn then playerAddedConn:Disconnect() playerAddedConn = nil end
            if playerRemovingConn then playerRemovingConn:Disconnect() playerRemovingConn = nil end
            clearAllThreats()
        end
    end)
end

local function removeNoThreatsScreenButton()
    if noThreatsGuiButton then
        noThreatsGuiButton:Destroy()
        noThreatsGuiButton = nil
    end
    noThreatsRunning = false
    if playerAddedConn then playerAddedConn:Disconnect() playerAddedConn = nil end
    if playerRemovingConn then playerRemovingConn:Disconnect() playerRemovingConn = nil end
    clearAllThreats()
end

