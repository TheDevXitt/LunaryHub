local function saveConfig()
    if writefile then
        local data = {
            theme = currentThemeName,
            height = currentHeight,
            width = currentWidth,
            autoWins = autoWinsActive,
            coinFarm = coinFarmActive,
            skin = skinActive,
            autoReturn = autoReturnActive,
            antivoid = antivoidActive,
            antiRagdoll = antiRagdollActive
        }
        pcall(function()
            writefile(configFileName, HttpService:JSONEncode(data))
        end)
    end
end

local function loadConfig()
    if readfile and pcall(readfile, configFileName) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(configFileName))
        end)
        if success and result then
            if result.theme then
                for _, t in ipairs(themes) do
                    if t.Name == result.theme then
                        currentThemeName = t.Name
                        currentThemeColor = t.Color
                        currentFloatingImage = t.Image
                        floatingRotate = t.Rotate
                        break
                    end
                end
            end
            if result.height then currentHeight = math.clamp(result.height, 240, 480) end
            if result.width then currentWidth = math.clamp(result.width, 300, 600) end
            if result.antivoid ~= nil then antivoidActive = result.antivoid end
        end
    end
end

