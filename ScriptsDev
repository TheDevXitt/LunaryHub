local function switchTab(selectedTab)
    local containers = {Principal = MainContainer, OP = OpContainer, Teleportes = TpContainer, Custom = CustomContainer, Config = SettingsContainer}
    for name, container in pairs(containers) do
        if name == selectedTab then
            container.Visible = true
            container.Position = UDim2.new(0, 20, 0, 80)
            TweenService:Create(container, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(0, 10, 0, 80)
            }):Play()
        else
            container.Visible = false
        end
    end

    MainTabBtn.BackgroundColor3 = (selectedTab == "Principal") and Color3.fromRGB(30, 30, 30) or Color3.fromRGB(15, 15, 15)
    MainTabBtn.TextColor3 = (selectedTab == "Principal") and currentThemeColor or Color3.fromRGB(180, 180, 180)

    OpTabBtn.BackgroundColor3 = (selectedTab == "OP") and Color3.fromRGB(30, 30, 30) or Color3.fromRGB(15, 15, 15)
    OpTabBtn.TextColor3 = (selectedTab == "OP") and currentThemeColor or Color3.fromRGB(180, 180, 180)

    TpTabBtn.BackgroundColor3 = (selectedTab == "Teleportes") and Color3.fromRGB(30, 30, 30) or Color3.fromRGB(15, 15, 15)
    TpTabBtn.TextColor3 = (selectedTab == "Teleportes") and currentThemeColor or Color3.fromRGB(180, 180, 180)

    CustomTabBtn.BackgroundColor3 = (selectedTab == "Custom") and Color3.fromRGB(30, 30, 30) or Color3.fromRGB(15, 15, 15)
    CustomTabBtn.TextColor3 = (selectedTab == "Custom") and currentThemeColor or Color3.fromRGB(180, 180, 180)
end

